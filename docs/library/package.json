{
  "name": "aslice-documentation-library",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "node .harness/launch.mjs",
    "dev": "node .harness/launch.mjs",
    "build": "npm run typecheck && vite build --config .harness/vite.config.ts && node .harness/tooling/check-browser.mjs",
    "serve": "node .harness/launch.mjs --built",
    "preview": "node .harness/launch.mjs --built",
    "typecheck": "tsc --noEmit -p .harness/tsconfig.json",
    "lint": "oxlint --deny-warnings .harness/src .harness/tooling .harness/launch.mjs .harness/vite.config.ts",
    "format": "prettier --ignore-path .harness/.prettierignore --write package.json .harness",
    "format:check": "prettier --ignore-path .harness/.prettierignore --check package.json .harness",
    "test": "vitest run --config .harness/vite.config.ts && node --test .harness/tooling/launch.test.mjs && python -m unittest discover -s .harness/tests -p test_*.py",
    "test:watch": "vitest --config .harness/vite.config.ts",
    "test:browser": "playwright test --config .harness/playwright.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "core-js": "3.50.0",
    "whatwg-fetch": "3.6.20"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/preset-env": "8.0.6",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "acorn": "8.18.0",
    "autoprefixer": "10.6.1",
    "jsdom": "30.1.1",
    "oxlint": "1.85.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "sass": "1.105.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
