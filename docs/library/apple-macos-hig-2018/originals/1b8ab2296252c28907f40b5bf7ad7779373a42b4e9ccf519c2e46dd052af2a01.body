/* Custom Icons > Size Table Formatting */
table tr td:nth-of-type(1) {
  width: 50%;
}


/* System Provided Icons Table Formatting */
table:nth-of-type(2) thead tr th:first-of-type {
  width: 10%;
}

@media only screen and (max-width: 735px) {
	table:nth-of-type(2) thead tr th:first-of-type {
		width: 15%;
	}
}

table:nth-of-type(2) thead tr th:nth-of-type(2) {
	width:20%;
}
table:nth-of-type(2) thead tr th:nth-of-type(3) {
	width:40%;
}
table:nth-of-type(2) thead tr th:nth-of-type(4) {
	width:30%;
}

table:nth-of-type(2) tr td {
	vertical-align: middle;
} 

table:nth-of-type(2) tr td:nth-of-type(1) {
	padding-top:.8em;
}       