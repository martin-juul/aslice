table {
	margin-bottom: 1em;
	border-collapse: separate;
	border-spacing: nil;
}


.visualindex-element {
	display: flex;
}

.visualindex-element p:last-child {
	margin-bottom: 0;
}

.visualindex-thumbnail {
	width: 100px;
	height: 80px;
	flex-shrink: 0;
	margin-right: 1em;
}

table img {
	display: block;
}

/*@media (prefers-reduced-motion) {
}*/

.visualindex-row [class*=col-50] {
	height: auto;
}

.hig-content [class*=col-] {
	  padding-top:1.5em;
	  padding-bottom:0;
}
@media all and (max-width: 1068px) {
	.visualindex-thumbnail {
	    width: 90px;
	    height: auto;
	    flex-shrink: 0;
	    margin-right: 1em;
	}
}
@media all and (max-width: 735px) {
  .hig-content [class*=col-] {
    padding-bottom: 24px;
  }
}