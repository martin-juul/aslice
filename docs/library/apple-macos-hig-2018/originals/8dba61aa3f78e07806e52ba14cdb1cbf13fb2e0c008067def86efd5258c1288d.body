					<a href="/design/human-interface-guidelines/macos/icons-and-images/multi-item-drag-images/" class="nextrouter-content block">

						<span class="nextrouter-copy no-padding-top no-padding-bottom">
							<h4>
								<span class="nextrouter-label">Next</span>
