/* Control Icons */
table:nth-of-type(1) thead tr th:nth-of-type(1) {
  width: 10%;
}
table:nth-of-type(1) thead tr th:nth-of-type(2) {
	width:15%;
}
table:nth-of-type(1) thead tr th:nth-of-type(3) {
	width:40%;
}
table:nth-of-type(1) thead tr th:nth-of-type(4) {
	width:35%;
}

/* Freestanding Button Icons */
table:nth-of-type(2) thead tr th:nth-of-type(1) {
  width: 10%;
}
table:nth-of-type(2) thead tr th:nth-of-type(2) {
	width:15%;
}
table:nth-of-type(2) thead tr th:nth-of-type(3) {
	width:40%;
}
table:nth-of-type(2) thead tr th:nth-of-type(4) {
	width:35%;
}

/* Menu Icons */
table:nth-of-type(3) thead tr th:nth-of-type(1) {
  width: 10%;
}
table:nth-of-type(3) thead tr th:nth-of-type(2) {
	width:15%;
}
table:nth-of-type(3) thead tr th:nth-of-type(3) {
	width:40%;
}
table:nth-of-type(3) thead tr th:nth-of-type(4) {
	width:35%;
}

/* Multiple Document Drag Images */
table:nth-of-type(4) thead tr th:nth-of-type(1) {
  width: 33%;
}
table:nth-of-type(4) thead tr th:nth-of-type(2) {
	width:33%;
}
table:nth-of-type(4) thead tr th:nth-of-type(3) {
	width:34%;
}

/* Permissions Icons */
table:nth-of-type(5) thead tr th:nth-of-type(1) {
  width: 33%;
}
table:nth-of-type(5) thead tr th:nth-of-type(2) {
	width:33%;
}
table:nth-of-type(5) thead tr th:nth-of-type(3) {
	width:34%;
}

/* Preferences Icons */
table:nth-of-type(6) thead tr th:nth-of-type(1) {
  width: 33%;
}
table:nth-of-type(6) thead tr th:nth-of-type(2) {
	width:33%;
}
table:nth-of-type(6) thead tr th:nth-of-type(3) {
	width:34%;
}

/* Status Icons */
table:nth-of-type(7) thead tr th:nth-of-type(1) {
  width: 33%;
}
table:nth-of-type(7) thead tr th:nth-of-type(2) {
	width:33%;
}
table:nth-of-type(7) thead tr th:nth-of-type(3) {
	width:34%;
}

/* System Entity Icons */
table:nth-of-type(8) thead tr th:nth-of-type(1) {
  width: 33%;
}
table:nth-of-type(8) thead tr th:nth-of-type(2) {
	width:33%;
}
table:nth-of-type(8) thead tr th:nth-of-type(3) {
	width:34%;
}

/* Toolbar Icons */
table:nth-of-type(9) thead tr th:nth-of-type(1) {
  width: 10%;
}
table:nth-of-type(9) thead tr th:nth-of-type(2) {
	width:15%;
}
table:nth-of-type(9) thead tr th:nth-of-type(3) {
	width:40%;
}
table:nth-of-type(9) thead tr th:nth-of-type(4) {
	width:35%;
}

table tr td {
	vertical-align: middle;
} 

table tr td:nth-of-type(1) {
	padding-top:.8em;
}       
      


