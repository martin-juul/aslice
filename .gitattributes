# Default: let Git decide, normalize to LF in the repo
* text=auto

# Archived source hashes refer to exact working-tree bytes on every platform.
docs/refs/** -text

# C++ sources: always LF in the repo, native on checkout
*.cpp text
*.cc  text
*.cxx text
*.h   text
*.hpp text
*.hh  text
*.c   text
*.txt text
*.md  text

# Visual Studio / Windows-only files that must keep CRLF
*.sln    text eol=crlf
*.vcxproj text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Shell scripts must keep LF or they break on Linux/macOS
*.sh   text eol=lf

# Never touch these (they're binary)
*.png  binary
*.jpg  binary
*.ico  binary
*.pdf  binary
*.pdb  binary
*.dll  binary
*.exe  binary
*.a    binary
*.so   binary
*.dylib binary
