{
  "name": "aslice-simulator-console",
  "private": true,
  "scripts": {
    "dev": "vite --mode demo",
    "dev:live": "vite --mode live",
    "start": "npm run dev",
    "build": "npm run typecheck && vite build",
    "build:demo": "npm run typecheck && vite build --mode demo",
    "preview": "vite preview",
    "serve": "vite preview",
    "preview:demo": "vite preview --mode demo",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "oxlint --type-aware --deny-warnings src tooling vite.config.ts",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "check:browser": "node tooling/check-browser.ts"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/preset-env": "8.0.6",
    "@types/node": "26.6.3",
    "@types/novnc__novnc": "1.6.0",
    "@vitest/coverage-v8": "5.0.2",
    "@xterm/headless": "6.0.0",
    "acorn": "8.18.0",
    "autoprefixer": "10.6.1",
    "jsdom": "30.1.1",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "sass": "1.105.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@novnc/novnc": "1.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-image": "0.9.0",
    "@xterm/addon-progress": "0.2.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "abortcontroller-polyfill": "1.7.8",
    "core-js": "3.50.0",
    "fast-text-encoding": "1.0.6",
    "js-sha256": "1.0.0",
    "jsbi": "4.3.2",
    "pepjs": "0.5.3",
    "resize-observer-polyfill": "1.5.1",
    "whatwg-fetch": "3.6.20",
    "zod": "4.6.5"
  },
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
