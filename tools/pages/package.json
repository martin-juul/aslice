{
  "name": "aslice-pages",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "npm run typecheck && vite build && npm run check:browser",
    "typecheck": "tsc --noEmit",
    "check:browser": "node tooling/check-browser.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/preset-env": "8.0.6",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "acorn": "8.18.0",
    "autoprefixer": "10.6.1",
    "mermaid": "11.17.2",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
