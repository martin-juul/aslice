{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aslice.sh/schematics/json/operation-request.schema.json",
  "title": "Operation request",
  "description": "Version 1 structural contract. Normative field semantics: docs/STATE-AND-RECOVERY.md section 10.2 and docs/DATABASE.md section 9. Cryptography, canonical encoding, chain continuity, ordering, and filesystem safety require semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": 1
    },
    "action": {
      "enum": [
        "status",
        "stop",
        "continue",
        "manual",
        "salvage",
        "activate"
      ]
    },
    "operation_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "dry_run": {
      "type": "boolean"
    },
    "accept_system_changes": {
      "type": "boolean"
    },
    "accept_grafts": {
      "type": "boolean"
    }
  },
  "required": [
    "format",
    "action",
    "operation_id",
    "plan_digest",
    "dry_run",
    "accept_system_changes",
    "accept_grafts"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "stop"
          }
        }
      },
      "then": {
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "continue",
              "manual",
              "salvage",
              "activate"
            ]
          },
          "dry_run": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "plan_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
