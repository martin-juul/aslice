{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aslice.sh/schematics/json/recovery-checkpoint.schema.json",
  "title": "Recovery checkpoint",
  "description": "Version 1 structural contract. Normative field semantics: docs/STATE-AND-RECOVERY.md section 10.2 and docs/DATABASE.md section 9. Cryptography, canonical encoding, chain continuity, ordering, and filesystem safety require semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "enum": [
            "dev",
            "staging",
            "prod"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issued_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires_at": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "root_chain": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "digest",
              "size"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "floors": {
          "type": "object",
          "properties": {
            "root": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "version": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "metadata": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "digest",
                    "size"
                  ]
                }
              },
              "required": [
                "version",
                "metadata"
              ]
            },
            "targets": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "version": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "metadata": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "digest",
                    "size"
                  ]
                }
              },
              "required": [
                "version",
                "metadata"
              ]
            },
            "snapshot": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "version": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "metadata": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "digest",
                    "size"
                  ]
                }
              },
              "required": [
                "version",
                "metadata"
              ]
            },
            "timestamp": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "version": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "metadata": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "digest",
                    "size"
                  ]
                }
              },
              "required": [
                "version",
                "metadata"
              ]
            }
          },
          "required": [
            "root",
            "targets",
            "snapshot",
            "timestamp"
          ],
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "metadata": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "digest",
                  "size"
                ]
              }
            },
            "required": [
              "version",
              "metadata"
            ]
          }
        },
        "revocations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "digest",
            "size"
          ]
        },
        "signing_history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "digest",
              "size"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "lost_history": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "format",
        "repository",
        "environment",
        "sequence",
        "issued_at",
        "expires_at",
        "root_chain",
        "floors",
        "revocations",
        "signing_history",
        "lost_history"
      ]
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "keyid": {
            "type": "string",
            "minLength": 1
          },
          "sig": {
            "type": "string",
            "pattern": "^[0-9a-f]{128}$"
          }
        },
        "required": [
          "keyid",
          "sig"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    }
  },
  "required": [
    "signed",
    "signatures"
  ]
}
