{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aslice.sh/schematics/json/tuf/root.schema.json",
  "title": "TUF root metadata",
  "description": "Root role: the root of trust — keys and thresholds for every top-level role. Local copy derived from the upstream TUF 1.0.0 specification; where this file and upstream disagree, upstream wins and the copy is a bug (schematics/README.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signatures",
    "signed"
  ],
  "properties": {
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/signature"
      }
    },
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "_type",
        "spec_version",
        "version",
        "expires",
        "consistent_snapshot",
        "keys",
        "roles"
      ],
      "properties": {
        "_type": {
          "const": "root"
        },
        "spec_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "SemVer of the TUF specification this metadata follows."
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "expires": {
          "type": "string",
          "format": "date-time"
        },
        "consistent_snapshot": {
          "type": "boolean"
        },
        "keys": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/key"
          },
          "propertyNames": {
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "targets",
            "snapshot",
            "timestamp"
          ],
          "properties": {
            "root": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "keyids",
                "threshold"
              ],
              "properties": {
                "keyids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/keyid"
                  }
                },
                "threshold": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "targets": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "keyids",
                "threshold"
              ],
              "properties": {
                "keyids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/keyid"
                  }
                },
                "threshold": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "snapshot": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "keyids",
                "threshold"
              ],
              "properties": {
                "keyids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/keyid"
                  }
                },
                "threshold": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "timestamp": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "keyids",
                "threshold"
              ],
              "properties": {
                "keyids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/keyid"
                  }
                },
                "threshold": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyid",
        "sig"
      ],
      "properties": {
        "keyid": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sig": {
          "type": "string",
          "pattern": "^[0-9a-f]+$"
        }
      }
    },
    "hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]+$"
      },
      "description": "Digest algorithm → hex digest, e.g. sha256."
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keytype",
        "scheme",
        "keyval"
      ],
      "properties": {
        "keytype": {
          "type": "string",
          "enum": [
            "ed25519",
            "rsa",
            "ecdsa",
            "ecdsa-sha2-nistp256"
          ]
        },
        "scheme": {
          "type": "string",
          "minLength": 1
        },
        "keyval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "public"
          ],
          "properties": {
            "public": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "keyid_hash_algorithms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "keyid": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
