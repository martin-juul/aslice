{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aslice.sh/schematics/json/index-snapshot.schema.json",
  "title": "aslice index snapshot",
  "description": "The solver's world: a signed JSON snapshot of everything a repository serves, transported zstd-compressed with diffs under index/ (DESIGN §9.6). DERIVED: the prose fixes the per-package content (exact versions, build identities, source hashes — PACKAGE-FORMAT §7.1), the OS/flavor/arch tags (DESIGN §9.6), permanent tombstones (ORCHARD-POLICY §8), and signed graft manifests as index metadata (REPOSITORIES §3); the concrete layout is derived from those statements. Where this file and future prose disagree, the disagreement is a bug (schematics/README.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_version",
    "repository",
    "created",
    "packages"
  ],
  "properties": {
    "snapshot_version": {
      "type": "integer",
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Namespace of the serving repository."
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "revision",
          "build_id",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "description": "Normalized version (PACKAGE-FORMAT §4)."
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "build_id": {
            "type": "string",
            "pattern": "^[0-9a-f]+$"
          },
          "flavor": {
            "type": "string",
            "enum": [
              "v1",
              "v2",
              "v3"
            ],
            "description": "Absent on vendor packages: one slice serves every flavor (PACKAGE-FORMAT §3.11)."
          },
          "min_os": {
            "type": "string",
            "enum": [
              "10.11",
              "10.12",
              "10.13",
              "10.14",
              "10.15",
              "11",
              "12"
            ]
          },
          "max_os": {
            "type": "string",
            "enum": [
              "10.11",
              "10.12",
              "10.13",
              "10.14",
              "10.15",
              "11",
              "12"
            ]
          },
          "arch": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "x86_64",
                "i386"
              ]
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "variants": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            },
            "propertyNames": {
              "pattern": "^[a-z0-9][a-z0-9_]*$"
            },
            "description": "The default-variant set this slice was built with."
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Slice manifest digest in blobs/sha256/."
          },
          "source_hashes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "description": "Hashes of every vendored source artifact (PACKAGE-FORMAT §7.1)."
          },
          "graft_manifests": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "when",
                "signature"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "when": {
                  "type": "string",
                  "enum": [
                    "pre",
                    "post"
                  ]
                },
                "writes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "kexts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "daemons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "network": {
                  "type": "boolean",
                  "default": false
                },
                "elevated": {
                  "type": "boolean",
                  "default": false
                },
                "signature": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Signed index metadata (REPOSITORIES §3): project-signed for official, own-key for verified, null for third-party — the client's loud warning keys off the null."
                }
              }
            }
          }
        }
      }
    },
    "tombstones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "final_version",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "final_version": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "enum": [
              "upstream-eol",
              "security",
              "renamed",
              "unmaintainable",
              "takedown",
              "other"
            ]
          },
          "replacement": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        }
      },
      "description": "Permanent; historical snapshots and old locks resolve forever (ORCHARD-POLICY §8). Never delete the record."
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "description": "Historical renames, so adopt --from-homebrew and old locks keep resolving (ORCHARD-POLICY §3)."
    }
  }
}
