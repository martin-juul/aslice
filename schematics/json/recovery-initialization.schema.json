{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aslice.sh/schematics/json/recovery-initialization.schema.json",
  "title": "Recovery initialization",
  "description": "Version 1 structural contract. Normative field semantics: docs/STATE-AND-RECOVERY.md section 10.2 and docs/DATABASE.md section 9. Cryptography, canonical encoding, chain continuity, ordering, and filesystem safety require semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": 1
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "owner_uid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "prefix_path": {
      "type": "string",
      "minLength": 1
    },
    "recovery_path": {
      "type": "string",
      "minLength": 1
    },
    "protected_instance_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "format",
    "instance_id",
    "owner_uid",
    "prefix_path",
    "recovery_path",
    "protected_instance_id"
  ]
}
