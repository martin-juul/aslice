{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aslice.sh/schematics/index-diff.schema.json",
  "title": "index-diff",
  "description": "TUF-authorized ordered byte-splice-v1 patch chain, each payload conforming to index-patch.schema.json. Bind base/result identities and enforce local resource limits. Semantics: docs/REPOSITORIES.md authenticated-index-refresh.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": 1
    },
    "repository_identity": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "enum": [
        "dev",
        "staging",
        "prod"
      ]
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "digest",
        "size"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "digest",
        "size"
      ]
    },
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "codec": {
            "const": "byte-splice-v1"
          },
          "object": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "digest",
              "size"
            ]
          },
          "result": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "digest",
              "size"
            ]
          }
        },
        "required": [
          "codec",
          "object",
          "result"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "full": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "digest",
            "size"
          ]
        },
        "expanded": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "digest",
            "size"
          ]
        }
      },
      "required": [
        "object",
        "expanded"
      ]
    }
  },
  "required": [
    "format",
    "repository_identity",
    "environment",
    "base",
    "result",
    "patches",
    "full"
  ]
}
