{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aslice.sh/schematics/index-patch.schema.json",
  "title": "Bounded byte-splice index patch",
  "description": "REPOSITORIES authenticated-index-refresh. Copy ranges refer only to verified immutable base bytes. Append operations in order; verify exact result digest/length. Enforce streaming byte, memory, time and operation-count bounds before allocation. No filesystem paths or executable commands.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": 1
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "digest",
        "size"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "digest",
        "size"
      ]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "copy"
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "op",
              "offset",
              "length"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "insert"
              },
              "hex": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{2})+$"
              }
            },
            "required": [
              "op",
              "hex"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "format",
    "base",
    "result",
    "operations"
  ]
}
