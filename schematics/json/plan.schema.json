{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aslice.sh/schematics/json/plan.schema.json",
  "title": "Exact package operation plan",
  "description": "Normative structure; semantics and authorization: docs/STATE-AND-RECOVERY.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plan_version": {
      "const": 1
    },
    "generated_by": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "base_generation": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "identity": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "string",
            "enum": [
              "dev",
              "staging",
              "prod"
            ]
          },
          "index_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "namespace",
          "identity",
          "environment",
          "index_digest"
        ]
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "string",
          "pattern": "^(10\\.1[1-5]|11|12)(\\.[0-9]+)?$"
        },
        "flavor": {
          "type": "string",
          "enum": [
            "v1",
            "v2",
            "v3"
          ]
        }
      },
      "required": [
        "os",
        "flavor"
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "install",
              "upgrade",
              "reinstall",
              "remove"
            ]
          },
          "before": {
            "$ref": "package-record.schema.json"
          },
          "after": {
            "$ref": "package-record.schema.json"
          }
        },
        "required": [
          "action"
        ],
        "oneOf": [
          {
            "properties": {
              "action": {
                "const": "install"
              }
            },
            "required": [
              "after"
            ],
            "not": {
              "required": [
                "before"
              ]
            }
          },
          {
            "properties": {
              "action": {
                "enum": [
                  "upgrade",
                  "reinstall"
                ]
              }
            },
            "required": [
              "before",
              "after"
            ]
          },
          {
            "properties": {
              "action": {
                "const": "remove"
              }
            },
            "required": [
              "before"
            ],
            "not": {
              "required": [
                "after"
              ]
            }
          }
        ]
      }
    },
    "announcements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_consents": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "grafts",
          "system-changes",
          "eol",
          "sip-off"
        ]
      },
      "uniqueItems": true
    }
  },
  "required": [
    "plan_version",
    "generated_by",
    "profile",
    "base_generation",
    "repositories",
    "machine",
    "actions"
  ]
}
