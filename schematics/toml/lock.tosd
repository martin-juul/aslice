# Exact profile lock. Semantics: docs/STATE-AND-RECOVERY.md §8.
[toml-schema]
version = "1.0.0"

[elements.lock_version]
type = "integer"
allowedvalues = [2]

[elements.generated_by]
type = "string"
minlength = 1

[elements.profile]
type = "string"
pattern = "^[a-z0-9][a-z0-9-]*$"

[elements.machine]
type = "table"

[elements.machine.os]
type = "string"
pattern = "^(10\\.1[1-5]|11|12)(\\.[0-9]+)?$"

[elements.machine.flavor]
type = "string"
allowedvalues = ["v1", "v2", "v3"]

[elements.repositories]
type = "array"
itemtype = "types.repositoriesItem"

[types.repositoriesItem]
type = "table"

[types.repositoriesItem.namespace]
type = "string"
pattern = "^[a-z0-9][a-z0-9-]*$"

[types.repositoriesItem.identity]
type = "string"
minlength = 1

[types.repositoriesItem.environment]
type = "string"
allowedvalues = ["dev", "staging", "prod"]

[types.repositoriesItem.index_digest]
type = "string"
pattern = "^sha256:[0-9a-f]{64}$"

[elements.package]
type = "array"
itemtype = "types.packageItem"

[types.packageItem]
type = "table"

[types.packageItem.repository]
type = "string"
pattern = "^[a-z0-9][a-z0-9-]*$"

[types.packageItem.name]
type = "string"
pattern = "^[a-z0-9][a-z0-9-]*$"

[types.packageItem.version]
type = "string"
minlength = 1

[types.packageItem.epoch]
type = "integer"
min = 0
max = 9007199254740991

[types.packageItem.revision]
type = "integer"
min = 0
max = 9007199254740991

[types.packageItem.build_id]
type = "string"
pattern = "^[0-9a-f]{64}$"

[types.packageItem.artifact_id]
type = "string"
pattern = "^sha256:[0-9a-f]{64}$"

[types.packageItem.manifest_size]
type = "integer"
min = 0
max = 9007199254740991

[types.packageItem.blob_digest]
type = "string"
pattern = "^sha256:[0-9a-f]{64}$"

[types.packageItem.blob_size]
type = "integer"
min = 0
max = 9007199254740991

[types.packageItem.recipe_digest]
type = "string"
pattern = "^sha256:[0-9a-f]{64}$"

[types.packageItem.recipe_size]
type = "integer"
min = 0
max = 9007199254740991

[types.packageItem.origin]
type = "string"
allowedvalues = ["slice", "local-build", "vendor-direct"]

[types.packageItem.variants]
type = "collection"
itemtype = "boolean"

[types.packageItem.user_flags]
type = "collection"
itemtype = "string"

[types.packageItem.cpu_features]
type = "array"
itemtype = "string"
uniqueitems = true

[types.packageItem.requires_i386]
type = "boolean"

[types.packageItem.min_os]
type = "string"
allowedvalues = ["10.11", "10.12", "10.13", "10.14", "10.15", "11", "12"]

[types.packageItem.max_os]
type = "string"
optional = true
allowedvalues = ["10.11", "10.12", "10.13", "10.14", "10.15", "11", "12"]

[types.packageItem.flavor]
type = "string"
optional = true
allowedvalues = ["v1", "v2", "v3"]

[types.packageItem.dependencies]
type = "array"
itemtype = "types.dependenciesItem"

[types.dependenciesItem]
type = "table"

[types.dependenciesItem.repository]
type = "string"
pattern = "^[a-z0-9][a-z0-9-]*$"

[types.dependenciesItem.name]
type = "string"
pattern = "^[a-z0-9][a-z0-9-]*$"

[types.dependenciesItem.artifact_id]
type = "string"
pattern = "^sha256:[0-9a-f]{64}$"

[types.packageItem.vendor]
type = "table"
optional = true

[types.packageItem.vendor.url]
type = "string"

[types.packageItem.vendor.digest]
type = "string"
pattern = "^sha256:[0-9a-f]{64}$"

[types.packageItem.vendor.signer]
type = "string"
optional = true
minlength = 1

[elements.selections]
type = "array"
itemtype = "types.selection"

[types.selection]
type = "table"

[types.selection.kind]
type = "string"
allowedvalues = ["provider", "alias", "replacement"]

[types.selection.requested]
type = "string"
pattern = "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$"

[types.selection.selected]
type = "string"
pattern = "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$"

[types.selection.repository_identity]
type = "string"
minlength = 1
