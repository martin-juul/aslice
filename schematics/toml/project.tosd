# TOML Schema for ./aslice.toml — project-tree runtime pins, written by
# `aslice pin <runtime> <stream>`; found by walking up from the working
# directory. Commit it.
# Prose specification: docs/DESIGN.md §12.9 and man/aslice-use.1.md.
#
# DERIVED: the prose fixes the content — one file pinning every runtime in the
# repository to a stream (8.4), never an exact patch — but not the table header.
# This schematic fixes it as [pins], the project-layer sibling of the machine
# file's [runtimes.default] (SETUP §2.3). Where this file and future prose
# disagree, the disagreement is a bug (schematics/README.md).

[toml-schema]
version = "1.0.0"

[toml-schema.meta]
target = "aslice.toml (project tree)"
prose = "docs/DESIGN.md §12.9; man/aslice-use.1.md"
prose_version = "1.20"
derived = "table header unnamed in prose"
schematics = "0.1"

[types.stream]
type = "string"
pattern = "^[0-9][a-zA-Z0-9._-]*$"
description = "A release stream such as 8.4 — never an exact patch (aslice-use(1))."

[elements.pins]
type = "collection"
itemtype = "types.stream"
keypattern = "^[a-z0-9][a-z0-9-]*$"
description = "Runtime name → stream. Resolution order: session (aslice use) → project (this file) → default (state DB) → sole installed stream (DESIGN §12.9)."
